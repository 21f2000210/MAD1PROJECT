# ============================================================
# A-Z Household Services – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.
# ============================================================

# Flask
SECRET_KEY=your-very-secret-key-change-this-in-production

# Database (default: SQLite for development)
DATABASE_URI=sqlite:///database.db
# For PostgreSQL (production): postgresql://user:password@localhost/dbname

# ---- AI Features (Claude API) ----
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Email Notifications (Flask-Mail) ----
# Example: Gmail SMTP. For Gmail, use an App Password (not your real password).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@azhousehold.com
